{
  "name": "EPUB",
  "description": "PDF-to-XHTML (EPUB) profile. Zone tags use Mapping.xml's own element vocabulary directly, so the intermediate XML this profile's generator emits needs no separate tag-translation table - Mapping.xml's find= XPaths match these tag names verbatim. Extend this list by editing this file; no code change needed.",
  "xml_enabled": false,
  "xhtml_enabled": true,
  "root_tag": "component",
  "mapping_xml_path": "",
  "page_marker_tags": [],
  "footnote_flow_tags": ["fn", "en"],
  "component_types": [
    "cover", "halftitle", "series", "titlepage", "copyrightpage", "dedication", "toc",
    "preface", "contributor", "acknow", "foreword", "introduction", "fm",
    "chapter", "part", "section", "appendix", "glossary", "index", "bibliography", "bm"
  ],
  "default_component_type": "chapter",

  "image_kinds": {
    "cover":     {"token": "cover",   "ext": "jpg", "digits": 0, "no_prefix": true},
    "publogo":   {"token": "logo",    "ext": "jpg", "digits": 0},
    "copylogo":  {"token": "logo",    "ext": "jpg", "digits": 0},
    "img":       {"token": "fig",     "ext": "png", "digits": 2},
    "uncapfig":  {"token": "figu",    "ext": "png", "digits": 2},
    "tblimage":  {"token": "tbl",     "ext": "png", "digits": 2},
    "uncaptblimage": {"token": "tblu", "ext": "png", "digits": 2},
    "eqn_img":   {"token": "eqn",     "ext": "png", "digits": 2},
    "ineq_img":  {"token": "inline",  "ext": "png", "digits": 2},
    "proimage":  {"token": "codfig",  "ext": "png", "digits": 2},
    "inlinefig": {"token": "inline", "counter_key": "ineq_img", "ext": "png", "digits": 2, "note": "Confirmed with the user: Inline Equation and Inline Figure intentionally SHARE one 'inline' filename sequence (spec section 16: Inline Equation -> ch1-inline-01.png, then the next Inline Figure -> ch1-inline-02.png) - counter_key points this entry at Inline Equation's own 'ineq_img' counter instead of starting a separate one under 'inlinefig', which would otherwise also produce -01 first and collide on disk."},
    "iconfig":   {"token": "icon",    "ext": "png", "digits": 2}
  },

  "tag_buttons": [
    {"label": "Cover", "tag": "cover", "attrs": {"asset_kind": "cover"}},
    {"label": "Publisher Logo", "tag": "publogo", "attrs": {"asset_kind": "publogo"}},
    {"label": "Copyright Logo", "tag": "copylogo", "attrs": {"asset_kind": "copylogo"}},

