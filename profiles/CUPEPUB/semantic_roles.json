{
  "_comment": [
    "Semantic ROLE vocabulary for Auto Tag (core/tag_knowledge). This file does NOT list output tags.",
    "Each role describes a structural CONCEPT the layout/semantic engine can recognise on a page, as groups of",
    "synonym words. Auto Tag resolves every role to the project's real tag by matching these words against the",
    "project's own tag labels/names/attribute values (CUPEPUB_Zoning.xml + CUPLookup.xml) and Mapping.xml output",
    "class / epub:type / role values, then ranks the matches with DTD, reference-corpus, reference-project and",
    "user-correction evidence. A role that matches no project tag is simply never applied.",
    "  all      : every group must be satisfied by at least one word in the tag's tokens",
    "  none     : the tag is rejected if any of these words is among its own (label/name) tokens",
    "  image    : true = only image tags qualify, false/absent = only text tags qualify",
    "  levels   : expands {level} into level-specific roles name_1..name_N"
  ],
  "roles": {
    "title":               {"all": [["title", "maintitle", "booktitle"]], "none": ["sub", "toc", "fig", "box", "poem", "dialog", "abs", "kwd", "statement", "pro", "tbl", "table", "msttitle", "head"]},
    "subtitle":            {"all": [["subtitle"]], "none": ["toc"]},
    "author":              {"all": [["au", "author"]], "none": ["toc"]},
    "affiliation":         {"all": [["aff", "affiliation"]], "none": ["toc"]},
    "label":               {"all": [["label"]], "none": ["toc"]},
    "heading":             {"all": [["h", "head", "heading"], ["{level}"]], "none": ["toc", "box", "boxsec", "index", "sec", "en", "ref", "ack", "gloss", "ex", "exercise"], "levels": 6},
    "paragraph":           {"all": [["para", "p", "paragraph"]], "none": ["list", "box", "abs", "ex", "exercise", "exe", "b", "bpara"]},
    "paragraph_noindent":  {"all": [["para", "p", "paragraph"], ["noindent", "flush"]], "none": ["list", "ex", "exe", "exercise"]},
    "paragraph_center":    {"all": [["para", "p", "paragraph"], ["center", "centre", "centered"]]},
    "paragraph_right":     {"all": [["para", "p", "paragraph"], ["right"]]},
    "paragraph_hanging":   {"all": [["para", "p", "paragraph"], ["hang", "hanging"]]},
    "list_numbered":       {"all": [["list", "li"], ["num", "number", "numbered", "decimal", "ordered"]], "none": ["toc", "page"]},
    "list_bullet":         {"all": [["list", "li"], ["bull", "bullet", "bulleted", "unordered"]]},
    "list_upper_alpha":    {"all": [["list", "li"], ["upper"], ["alpha"]]},
    "list_lower_alpha":    {"all": [["list", "li"], ["lower"], ["alpha"]]},
    "list_upper_roman":    {"all": [["list", "li"], ["upper"], ["roman"]]},
    "list_lower_roman":    {"all": [["list", "li"], ["lower"], ["roman"]]},
    "list_plain":          {"all": [["list", "li"], ["plain", "simple"]]},
    "list_continuation":   {"all": [["list", "li"], ["para", "p", "continuation"]]},
    "caption":             {"all": [["caption", "figcaption"]], "none": ["tbl", "table"]},
    "figure_title":        {"all": [["fig", "figure"], ["title"]], "none": ["toc"]},
    "figure_source":       {"all": [["fig", "figure"], ["source", "credit"]]},
    "figure":              {"all": [["image", "img", "figure", "fig", "illustration"]], "none": ["cover", "logo", "icon", "tbl", "table", "eqn", "ineq", "pro", "inline", "uncap", "map", "illus", "photo", "chart", "graph", "diagram"], "image": true},
    "table":               {"all": [["table", "tbl"]], "none": ["caption", "foot", "source", "image", "uncap", "toc"]},
    "table_caption":       {"all": [["tbl", "table"], ["caption"]]},
    "table_footnote":      {"all": [["tbl", "table"], ["foot", "footnote", "note"]]},
    "table_source":        {"all": [["tbl", "table"], ["source"]]},
    "footnote":            {"all": [["fn", "footnote"]], "none": ["tbl", "table"]},
    "endnote":             {"all": [["endnote", "endnotes"]], "none": ["head"]},
    "endnote_heading":     {"all": [["en", "endnote", "endnotes", "notes"], ["head", "heading"]]},
    "page_number":         {"all": [["page", "pagenum", "folio"], ["num", "number", "pagenum", "folio"]], "none": ["toc"]},
    "blockquote":          {"all": [["blockquote", "quote", "extract"]], "none": ["source"]},
    "blockquote_source":   {"all": [["blockquote", "quote", "extract"], ["source", "attribution"]]},
    "epigraph":            {"all": [["epigraph", "epi"]], "none": ["source"]},
    "epigraph_source":     {"all": [["epigraph", "epi"], ["source", "attribution"]]},
    "verse_line":          {"all": [["poem", "verse", "poetry", "stanza"], ["line"]], "none": ["title", "source"]},
    "verse_title":         {"all": [["poem", "verse", "poetry"], ["title"]]},
    "verse_source":        {"all": [["poem", "verse", "poetry"], ["source", "attribution"]]},
    "reference_numbered":  {"all": [["ref", "reference", "bib", "biblio"], ["n", "num", "numbered"]], "none": ["head"]},
    "reference_author_date": {"all": [["ref", "reference", "bib", "biblio"], ["d", "date", "authordate"]], "none": ["head"]},
    "reference_heading":   {"all": [["ref", "reference", "bib", "biblio"], ["head", "heading", "title"]]},
    "equation":            {"all": [["eqn", "equation", "math"]], "none": ["in", "inline", "ineq", "num"], "image": true},
    "running_header":      {"all": [["running", "runninghead", "rh", "header"]]},
    "running_footer":      {"all": [["running", "runningfoot", "rf", "footer"]]}
  }
}
